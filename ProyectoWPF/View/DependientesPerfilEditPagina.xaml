<Page x:Class="ProyectoWPF.View.DependientesPerfilEditPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DependientesPerfilEditPagina">

    <Grid Background="#FF979797">
        <Grid.RowDefinitions>
            <RowDefinition Height="157*"/>
            <RowDefinition Height="53*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Label Content="NSS:" HorizontalAlignment="Left" Height="25" Margin="344,205,0,0" VerticalAlignment="Top" Width="43" FontSize="16" Grid.Column="1" FontFamily="Bell MT" FontWeight="Bold"/>
        <Label Content="Nombre:" HorizontalAlignment="Left" Height="25" Margin="44,205,0,0" VerticalAlignment="Top" Width="70" FontSize="16" Grid.ColumnSpan="2" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label Content="Apellidos:" HorizontalAlignment="Left" Height="28" Margin="34,254,0,0" VerticalAlignment="Top" Width="80" FontSize="16" Grid.ColumnSpan="2" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label Content="Comisión:" HorizontalAlignment="Left" Height="24" Margin="312,255,0,0" VerticalAlignment="Top" Width="80" FontSize="16" Grid.Column="1" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Text="{Binding NSS}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="392,202,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="293" FontSize="14"/>
        <TextBox Text="{Binding Nombre}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="42,202,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="212" FontSize="14"/>
        <TextBox Text="{Binding Apellido}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="42,254,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="212" FontSize="14"/>
        <TextBox Text="{Binding Comision}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="392,252,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="293" FontSize="14"/>
        <Button  Click="Editar" Command="{Binding Path=UpdateCommad}" Content="Guardar" Grid.Column="1" HorizontalAlignment="Left" Height="96" Margin="438,0,0,0" VerticalAlignment="Top" Width="247" Background="#191970" FontSize="30" Grid.Row="1" BorderThickness="0"/>
        <Button Click="Dependientes" Content="Dependientes" HorizontalAlignment="Left" Height="79" Margin="10,10,0,0" VerticalAlignment="Top" Width="233" Background="#FF979797" FontSize="30" BorderThickness="0" Grid.ColumnSpan="2"/>
        <TextBlock TextBlock.Foreground="Azure" Grid.Column="1" HorizontalAlignment="Left" Height="46" Margin="176,24,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252" FontSize="36"><Run Text="&gt;"/><Run Text=" "/><Run Text=" "/><Run Text="Editar"/><Run Text=" "/></TextBlock>

    </Grid>
</Page>
