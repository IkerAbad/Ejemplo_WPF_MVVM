<Page x:Class="ProyectoWPF.View.ArticuloInformacionEditPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ArticuloInformacionEditPagina">

    <Grid Background="#FF979797">
        <Grid.RowDefinitions>
            <RowDefinition Height="157*"/>
            <RowDefinition Height="53*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Código:" HorizontalAlignment="Left" Height="34" Margin="2,120,0,0" VerticalAlignment="Top" Width="69" FontSize="16" FontWeight="Bold" FontFamily="Bell MT" Grid.Column="1"/>
        <Label Content="Descripción:" HorizontalAlignment="Left" Height="34" Margin="42,185,0,0" VerticalAlignment="Top" Width="102" FontSize="16" Grid.ColumnSpan="2" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label Content="PCoste:" HorizontalAlignment="Left" Height="33" Margin="434,226,0,0" VerticalAlignment="Top" Width="84" FontSize="16" Grid.Column="1" FontFamily="Bell MT" FontWeight="Bold"/>
        <Label Content="IVA:" HorizontalAlignment="Left" Height="33" Margin="456,278,0,0" VerticalAlignment="Top" Width="42" FontSize="16" Grid.Column="1" FontFamily="Bell MT" FontWeight="Bold"/>
        <TextBox Text="{Binding CodigoArticulo}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="71,120,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="277"/>
        <TextBox Text="{Binding Descripcion}" HorizontalAlignment="Left" Height="146" Margin="42,219,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="379" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
        <TextBox Text="{Binding PCoste}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="518,226,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="167"/>
        <TextBox Text="{Binding IVA}" Grid.Column="1" HorizontalAlignment="Left" Height="34" Margin="518,272,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="167"/>
        <Button Content="Guardar" Grid.Column="1" HorizontalAlignment="Left" Height="96" Margin="424,0,0,0" VerticalAlignment="Top" Width="261" Background="#191970" FontSize="30" Grid.Row="1" BorderThickness="0"/>
        <Button Click="Articulos" Content="Articulos" HorizontalAlignment="Left" Height="74" Margin="10,10,0,0" VerticalAlignment="Top" Width="167" Background="#FF979797" FontSize="30" BorderThickness="0" Grid.ColumnSpan="2"/>
        <TextBlock TextBlock.Foreground="Azure" Grid.Column="1" HorizontalAlignment="Left" Height="46" Margin="110,20,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252" FontSize="36"><Run Text="&gt;"/><Run Text=" "/><Run FontSize="40" Text="Editar"/><Run Text=" "/></TextBlock>
        <Label Content="Nombre:" HorizontalAlignment="Left" Height="28" Margin="374,120,0,0" VerticalAlignment="Top" Width="75" FontSize="16" FontWeight="Bold" FontFamily="Bell MT" Grid.Column="1"/>
        <TextBox Text="{Binding Nombre}" HorizontalAlignment="Left" Height="33" Margin="456,119,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="231" Grid.Column="1"/>

    </Grid>
</Page>
