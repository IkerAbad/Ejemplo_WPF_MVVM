<Page x:Class="ProyectoWPF.View.VentasInformacionEditPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VentasInformacionEditPagina">

    <Grid Background="#FF979797">
        <Grid.RowDefinitions>
            <RowDefinition Height="157*"/>
            <RowDefinition Height="53*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Código:" HorizontalAlignment="Left" Height="28" Margin="47,145,0,0" VerticalAlignment="Top" Width="71" FontSize="16" Grid.ColumnSpan="2" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label Content="Importe:" HorizontalAlignment="Left" Height="28" Margin="438,149,0,0" VerticalAlignment="Top" Width="80" FontSize="16" Grid.Column="1" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label Content="Forma de Pago:" HorizontalAlignment="Left" Height="28" Margin="390,201,0,0" VerticalAlignment="Top" Width="128" FontSize="16" Grid.Column="1" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Text="{Binding Codigo}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="44,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="306" FontSize="14"/>
        <TextBox Text="{Binding Importe}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="517,144,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="168" FontSize="14"/>
        <Button Content="Guardar" Grid.Column="1" HorizontalAlignment="Left" Height="86" Margin="454,10,0,0" VerticalAlignment="Top" Width="231" Background="#191970" FontSize="30" Grid.Row="1" BorderThickness="0"/>
        <Label Content="Nº Tarjeta:" HorizontalAlignment="Left" Height="29" Margin="422,262,0,0" VerticalAlignment="Top" Width="96" FontSize="16" Grid.Column="1" FontWeight="Bold" FontFamily="Bell MT"/>
        <Calendar HorizontalAlignment="Left" Height="161" Margin="45,210,0,0" VerticalAlignment="Top" Width="217" Grid.RowSpan="2" Grid.Column="1">
            <Calendar.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFE4EAF0" Offset="0"/>
                    <GradientStop Color="#FFECF0F4" Offset="0.16"/>
                    <GradientStop Color="#FFFCFCFD" Offset="0.16"/>
                    <GradientStop Color="#FF3A318B" Offset="1"/>
                </LinearGradientBrush>
            </Calendar.Background>
        </Calendar>
        <TextBox Text="{Binding NTarjeta}" Grid.Column="1" HorizontalAlignment="Left" Height="33" Margin="517,262,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="168" FontSize="14"/>
        <ComboBox Grid.Column="1" HorizontalAlignment="Left" Height="34" Margin="518,197,0,0" VerticalAlignment="Top" Width="167" FontSize="14">
            <ComboBoxItem IsSelected="True">Sin Seleccionar</ComboBoxItem>
            <ComboBoxItem>Tarjeta</ComboBoxItem>
            <ComboBoxItem>Contado</ComboBoxItem>
        </ComboBox>
        <Button Click="Ventas" Content="Ventas" HorizontalAlignment="Left" Height="73.748" Margin="10,10.342,0,0" VerticalAlignment="Top" Width="126" Background="#FF979797" FontSize="30" BorderThickness="0" Grid.ColumnSpan="2"/>
        <TextBlock  TextBlock.Foreground="Azure" Grid.Column="1" HorizontalAlignment="Left" Height="45" Margin="69,20,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="281" FontSize="36"><Run Text="&gt;"/><Run Text=" "/><Run FontSize="40" Text=" "/><Run FontSize="40" Text="Editar"/><Run Text=" "/></TextBlock>

    </Grid>
</Page>
