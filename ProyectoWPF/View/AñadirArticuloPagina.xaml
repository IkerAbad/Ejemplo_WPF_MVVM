<Page x:Class="ProyectoWPF.View.AñadirArticuloPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AñadirArticuloPagina">

    <Grid Background="#FF979797">
        <Label Content="Codigo:" HorizontalAlignment="Left" Height="28" Margin="37,113,0,0" VerticalAlignment="Top" Width="69" FontSize="16" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Name="codigo" HorizontalAlignment="Left" Height="33" Margin="111,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="306"/>
        <Button Click="Articulos" Content="Articulos" HorizontalAlignment="Left" Height="74" Margin="10,10,0,0" VerticalAlignment="Top" Width="167" Background="#FF979797" FontSize="30" BorderThickness="0"/>
        <TextBlock TextBlock.Foreground="Azure" HorizontalAlignment="Left" Height="58" Margin="177,19,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="164" FontSize="36"><Run Text="&gt;"/><Run Text=" "/><Run FontSize="40" Text="Añadir"/><Run Text=" "/></TextBlock>
        <Label Content="Descripción:" HorizontalAlignment="Left" Height="29" Margin="37,177,0,0" VerticalAlignment="Top" Width="103" FontSize="16" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Name="descripcion" HorizontalAlignment="Left" Height="144" Margin="37,211,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="380"/>
        <Label Content="PCoste:" HorizontalAlignment="Left" Height="28" Margin="518,199,0,0" VerticalAlignment="Top" Width="66" FontSize="16" FontWeight="Bold" FontFamily="Bell MT" RenderTransformOrigin="0.813,0.738"/>
        <Label Content="IVA:" HorizontalAlignment="Left" Height="27" Margin="541,251,0,0" VerticalAlignment="Top" Width="43" FontSize="16" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Name="pcoste" HorizontalAlignment="Left" Height="33" Margin="589,197,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="168"/>
        <ComboBox Name="iva" HorizontalAlignment="Left" Height="34" Margin="590,251,0,0" VerticalAlignment="Top" Width="167">
            <ComboBoxItem IsSelected="True">Sin Seleccionar</ComboBoxItem>
            <ComboBoxItem>21</ComboBoxItem>
            <ComboBoxItem>10</ComboBoxItem>
            <ComboBoxItem>4</ComboBoxItem>
        </ComboBox>
        <Button Click="Añadir" Content="Añadir" HorizontalAlignment="Left" Height="96" Margin="496,313,0,0" VerticalAlignment="Top" Width="261" Background="#008F39" FontSize="30" BorderThickness="0"/>
        <Label Content="Nombre:" HorizontalAlignment="Left" Height="28" Margin="446,113,0,0" VerticalAlignment="Top" Width="75" FontSize="16" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Name="nombre" HorizontalAlignment="Left" Height="33" Margin="526,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="231"/>

    </Grid>
</Page>
