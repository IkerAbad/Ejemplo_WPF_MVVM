<Page x:Class="ProyectoWPF.View.ListaDependientesPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      xmlns:vm="clr-namespace:ProyectoWPF.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListaDependientesPagina">

    <Page.Resources>
        <vm:DependienteViewModel x:Key="DependienteVM"/>
    </Page.Resources>
  

    <Grid Background="#FF979797" DataContext="{StaticResource DependienteVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="87*"/>
            <RowDefinition Height="248*"/>
            <RowDefinition Height="84*"/>
        </Grid.RowDefinitions>
        <Button Click="Inicio" Content="Inicio" HorizontalAlignment="Left" Height="79" Margin="10,21,0,0" VerticalAlignment="Top" Width="102" Background="#FF979797" BorderThickness="0" FontSize="26" Grid.RowSpan="2"/>
        <TextBlock  TextBlock.Foreground="Azure" HorizontalAlignment="Left" Height="40" Margin="112,41,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="209" FontSize="26"><Run Text="&gt; "/><Run Text=" "/><Run Text="Dependientes"/></TextBlock>
        <Button Content="Añadir" HorizontalAlignment="Left" Height="71" Margin="326,21,0,0" VerticalAlignment="Top" Width="165" FontSize="24" Background="#191970" BorderThickness="0" Grid.RowSpan="2" Click="Añadir"/>
        <ListView Background="White" Name="DependientesGrid" Grid.Row="1" Margin="5,15,5,0" ItemsSource="{Binding Dependientes}">
            <ListView.View>
                <GridView x:Name="grdTest2">
                    <GridViewColumn Header="NSS" DisplayMemberBinding="{Binding NSS}" Width="120"/>
                    <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Nombre}"  Width="120" />
                    <GridViewColumn Header="Apellido" DisplayMemberBinding="{Binding Apellido}" Width="280" />
                    <GridViewColumn Header="Comision" DisplayMemberBinding="{Binding Comision}" Width="70" />
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="Ver" HorizontalAlignment="Left" Height="74" Margin="292,5,0,0" VerticalAlignment="Top" Width="166" FontSize="24" Background="#3B83BD" BorderThickness="0" Click="Ver" Grid.Row="2"/>
        <Button  Click="Editar" Content="Editar" HorizontalAlignment="Left" Height="74" Margin="78,6,0,0" VerticalAlignment="Top" Width="165" FontSize="24" Background="#006400" BorderThickness="0" Grid.Row="2"/>
        <Button Click="Borrar" Content="Eliminar" HorizontalAlignment="Left" Height="74" Margin="521,6,0,0" VerticalAlignment="Top" Width="165" FontSize="24" Background="#FF0000" BorderThickness="0" Grid.Row="2"/>
    </Grid>
</Page>
