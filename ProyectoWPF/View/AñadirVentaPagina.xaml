<Page x:Class="ProyectoWPF.View.AñadirVentaPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AñadirVentaPagina">

    <Grid Background="#FF979797">
        <Button Click="Ventas" Content="Ventas" HorizontalAlignment="Left" Height="73.748" Margin="10,10.342,0,0" VerticalAlignment="Top" Width="126" Background="#FF979797" FontSize="30" BorderThickness="0"/>
        <TextBlock  TextBlock.Foreground="Azure" HorizontalAlignment="Left" Height="46" Margin="136,16.474,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="281" FontSize="36"><Run Text="&gt;"/><Run Text=" "/><Run FontSize="40" Text=" "/><Run FontSize="40" Text="Información"/><Run Text=" "/></TextBlock>
        <Label Content="Código:" HorizontalAlignment="Left" Height="28" Margin="37,142,0,0" VerticalAlignment="Top" Width="74" FontSize="16" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Name="codigo" HorizontalAlignment="Left" Height="33" Margin="111,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="306"/>
        <Label Content="Importe:" HorizontalAlignment="Left" Height="28" Margin="518,148,0,0" VerticalAlignment="Top" Width="76" FontSize="16" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label Content="Forma de Pago:" HorizontalAlignment="Left" Height="33" Margin="463,197,0,0" VerticalAlignment="Top" Width="131" FontSize="16" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Name="importe" HorizontalAlignment="Left" Height="33" Margin="594,148,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="168"/>
        <Label Content="Nº Tarjeta:" HorizontalAlignment="Left" Height="28" Margin="500,247,0,0" VerticalAlignment="Top" Width="94" FontSize="16" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBox Name="ntarjeta" HorizontalAlignment="Left" Height="33" Margin="594,245,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="168"/>
        <ComboBox Name="formapago" HorizontalAlignment="Left" Height="34" Margin="594,196,0,0" VerticalAlignment="Top" Width="167">
            <ComboBoxItem IsSelected="True">Sin Seleccionar</ComboBoxItem>
            <ComboBoxItem>Tarjeta</ComboBoxItem>
            <ComboBoxItem>Contado</ComboBoxItem>
        </ComboBox>
        <Calendar Name="fecha" HorizontalAlignment="Left" Height="162" Margin="149,219,0,0" VerticalAlignment="Top" Width="217">
            <Calendar.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFE4EAF0" Offset="0"/>
                    <GradientStop Color="#FFECF0F4" Offset="0.16"/>
                    <GradientStop Color="#FFFCFCFD" Offset="0.16"/>
                    <GradientStop Color="#FF3A318B" Offset="1"/>
                </LinearGradientBrush>
            </Calendar.Background>
        </Calendar>
        <Button Click="Añadir" Content="Añadir" HorizontalAlignment="Left" Height="96" Margin="500,323,0,0" VerticalAlignment="Top" Width="261" Background="#008F39" FontSize="30" BorderThickness="0"/>

    </Grid>
</Page>
