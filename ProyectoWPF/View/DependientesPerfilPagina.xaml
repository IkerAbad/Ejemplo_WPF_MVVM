<Page x:Class="ProyectoWPF.View.DependientesPerfilPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DependientesPerfilPagina">

    <Grid Background="#FF979797">

        <Grid.Resources>
            <!-- Reason item template -->
            <DataTemplate x:Key="typeItemTemplate">
                <Label Content="{Binding XPath=@ExpenseType}"/>
            </DataTemplate>
            <!-- Amount item template -->
            <DataTemplate x:Key="amountItemTemplate">
                <Label Content="{Binding XPath=@ExpenseAmount}"/>
            </DataTemplate>
        </Grid.Resources>

        <Label Content="NSS:" HorizontalAlignment="Left" Height="28" Margin="453,162,0,0" VerticalAlignment="Top" Width="54" FontSize="20" FontFamily="Bell MT" FontWeight="Bold"/>
        <Label Content="Nombre:" HorizontalAlignment="Left" Height="28" Margin="37,159,0,0" VerticalAlignment="Top" Width="93" FontSize="20" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label Content="Apellidos:" HorizontalAlignment="Left" Height="37" Margin="26,209,0,0" VerticalAlignment="Top" Width="104" FontSize="20" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label TextBlock.Foreground="DarkRed" Content="Comisión:" HorizontalAlignment="Left" Height="34" Margin="409,212,0,0" VerticalAlignment="Top" Width="98" FontSize="20" FontFamily="Bell MT" FontWeight="Bold"/>
        <Button Content="Ver Ventas" HorizontalAlignment="Left" Height="96" Margin="538,322,0,0" VerticalAlignment="Top" Width="217" Background="#FF339CC4" FontSize="30" BorderThickness="0"/>
        <Button Click="Dependientes" Content="Dependientes" HorizontalAlignment="Left" Height="79" Margin="10,10,0,0" VerticalAlignment="Top" Width="233" Background="#FF979797" FontSize="30" BorderThickness="0"/>
        <TextBlock  TextBlock.Foreground="Azure" HorizontalAlignment="Left" Height="46" Margin="248,24,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252" FontSize="36"><Run Text="&gt;"/><Run Text=" "/><Run Text=" "/><Run Text="Perfil"/><Run Text=" "/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="34" Margin="172,159,0,0" TextWrapping="Wrap" Text="{Binding Nombre}" VerticalAlignment="Top" Width="216" FontSize="20"/>
        <TextBlock HorizontalAlignment="Left" Height="34" Margin="172,209,0,0" TextWrapping="Wrap" Text="{Binding Apellido}" VerticalAlignment="Top" Width="216" FontSize="20"/>
        <TextBlock HorizontalAlignment="Left" Height="34" Margin="549,162,0,0" TextWrapping="Wrap" Text="{Binding NSS}" VerticalAlignment="Top" Width="218" FontSize="20"/>
        <TextBlock HorizontalAlignment="Left" Height="34" Margin="549,212,0,0" TextWrapping="Wrap" Text="{Binding Comision}" VerticalAlignment="Top" Width="218" FontSize="20"/>

    </Grid>
</Page>
