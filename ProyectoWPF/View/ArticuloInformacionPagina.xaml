<Page x:Class="ProyectoWPF.View.ArticuloInformacionPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ArticuloInformacionPagina">

    <Grid Background="#FF979797">

        <Grid.Resources>
            <!-- Reason item template -->
            <DataTemplate x:Key="typeItemTemplate">
                <Label Content="{Binding XPath=@ExpenseType}"/>
            </DataTemplate>
            <!-- Amount item template -->
            <DataTemplate x:Key="amountItemTemplate">
                <Label Content="{Binding XPath=@ExpenseAmount}"/>
            </DataTemplate>
        </Grid.Resources>

        <Label x:Name="Nombre" Content="Nombre:" HorizontalAlignment="Left" Height="33" Margin="64,117,0,0" VerticalAlignment="Top" Width="86" FontSize="20" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label  x:Name="Descripcion" Content="Descripción:" HorizontalAlignment="Left" Height="39" Margin="32,172,0,0" VerticalAlignment="Top" Width="145" FontSize="20" FontWeight="Bold" FontFamily="Bell MT"/>
        <Label  x:Name="IVA" Content="IVA:" HorizontalAlignment="Left" Height="32" Margin="533,172,0,0" VerticalAlignment="Top" Width="49" FontSize="20" FontWeight="Bold" FontFamily="Bell MT"/>
        <Button Content="Ver Ventas" HorizontalAlignment="Left" Height="96" Margin="541,313,0,0" VerticalAlignment="Top" Width="217" Background="#FF339CC4" FontSize="30" BorderThickness="0"/>
        <TextBlock HorizontalAlignment="Left" Height="16" Margin="493,216,0,0" TextWrapping="Wrap" Text="-------------------------------------------------------------------" VerticalAlignment="Top" Width="286" Opacity="0.2"/>
        <Label TextBlock.Foreground="DarkRed" x:Name="PVenta" Content="PVenta:" HorizontalAlignment="Left" Height="32" Margin="501,244,0,0" VerticalAlignment="Top" Width="81" FontSize="20" FontWeight="Bold" FontFamily="Bell MT"/>
        <Button Click="Articulos" Content="Articulos" HorizontalAlignment="Left" Height="74" Margin="10,10,0,0" VerticalAlignment="Top" Width="167" Background="#FF979797" FontSize="30" BorderThickness="0"/>
        <TextBlock TextBlock.Foreground="Azure" HorizontalAlignment="Left" Height="46" Margin="182,20,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252" FontSize="36"><Run Text="&gt;"/><Run Text=" "/><Run FontSize="40" Text="Información"/><Run Text=" "/></TextBlock>
        <TextBlock Text="{Binding Nombre}" HorizontalAlignment="Left" Height="34" Margin="175,117,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="134" FontSize="20"><Run/><LineBreak/><Run/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Height="148" Margin="37,216,0,0" TextWrapping="Wrap" Text="{Binding Descripcion}" VerticalAlignment="Top" Width="382" FontSize="20"/>
        <TextBlock HorizontalAlignment="Left" Height="33" Margin="717,178,0,0" TextWrapping="Wrap" Text="{Binding IVA}" VerticalAlignment="Top" Width="53" FontSize="20" RenderTransformOrigin="-0.013,0.404"/>
        <TextBlock Text="{Binding PVenta}" HorizontalAlignment="Left" Height="32" Margin="717,250,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="53" FontSize="20"><Run/><LineBreak/><Run/></TextBlock>
        <Label x:Name="PCoste" Content="PCoste:" HorizontalAlignment="Left" Height="33" Margin="501,127,0,0" VerticalAlignment="Top" Width="81" FontSize="20" FontWeight="Bold" FontFamily="Bell MT"/>
        <TextBlock HorizontalAlignment="Left" Height="33" Margin="717,134,0,0" TextWrapping="Wrap" Text="{Binding PCoste}" VerticalAlignment="Top" Width="53" FontSize="20"/>

    </Grid>
</Page>
