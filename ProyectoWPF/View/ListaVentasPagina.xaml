<Page x:Class="ProyectoWPF.View.ListaVentasPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProyectoWPF.View"
      xmlns:vm="clr-namespace:ProyectoWPF.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListaVentasPagina">

    <Page.Resources>
        <vm:VentasViewModel x:Key="VentasVM"/>
    </Page.Resources>

    <Grid Background="#FF979797" DataContext="{StaticResource VentasVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="83*"/>
            <RowDefinition Height="248*"/>
            <RowDefinition Height="88*"/>
        </Grid.RowDefinitions>
        <Button Click="Inicio" Content="Inicio" HorizontalAlignment="Left" Height="83" Margin="10,10,0,0" VerticalAlignment="Top" Width="102" Background="#FF979797" BorderThickness="0" FontSize="26" Grid.RowSpan="2"/>
        <TextBlock TextBlock.Foreground="Azure" HorizontalAlignment="Left" Height="41" Margin="112,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" FontSize="26"><Run Text="&gt; "/><Run Text=" "/><Run Text="Ventas"/></TextBlock>
        <Button Content="Añadir" HorizontalAlignment="Left" Height="77" Margin="288,16,0,0" VerticalAlignment="Top" Width="165" FontSize="24" Background="#191970" BorderThickness="0" Grid.RowSpan="2" Click="Añadir"/>
        <ListView Background="White" Name="VentasGrid" Grid.Row="1" Margin="5,15,5,0" ItemsSource="{Binding Ventas}">
            <ListView.View>
                <GridView x:Name="grdTest3">
                    <GridViewColumn Header="Codigo" DisplayMemberBinding="{Binding Codigo}" Width="120"/>
                    <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding Fecha}"  Width="200" />
                    <GridViewColumn Header="Importe" DisplayMemberBinding="{Binding Importe}" Width="150" />
                    <GridViewColumn Header="FormaPago" DisplayMemberBinding="{Binding FormaPago}" Width="150" />
                    <GridViewColumn Header="NTarjeta" DisplayMemberBinding="{Binding NTarjeta}" Width="150" />
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="Ver" HorizontalAlignment="Left" Height="74" Margin="301,11,0,0" VerticalAlignment="Top" Width="166" FontSize="24" Background="#3B83BD" BorderThickness="0" Click="Ver" Grid.Row="2"/>
        <Button Click="Editar" Content="Editar" HorizontalAlignment="Left" Height="74" Margin="78,11,0,0" VerticalAlignment="Top" Width="165" FontSize="24" Background="#006400" BorderThickness="0" Grid.Row="2"/>
        <Button Click="Eliminar" Content="Eliminar" HorizontalAlignment="Left" Height="74" Margin="521,11,0,0" VerticalAlignment="Top" Width="165" FontSize="24" Background="#FF0000" BorderThickness="0" Grid.Row="2"/>
    </Grid>
</Page>
